# Both data sources used by this app are public, keyless APIs, so no
# environment variables are strictly required to run the project.
#
# OTruyen  -> https://otruyenapi.com/v1/api   (primary source)
# MangaDex -> https://api.mangadex.org        (fallback source)
#
# If you ever proxy requests through your own backend or add rate-limit
# keys, put them here and reference them via process.env.* in lib/api/*.
NEXT_PUBLIC_SITE_URL=https://yomikaze.example.com
